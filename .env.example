# Copy to apps/web/.env.local for local development. Never commit real values.
# The team receives real values through HQ (Settings -> Sandbox -> App variables), not a committed .env.
# Anything without NEXT_PUBLIC_ is server-only. Validated by apps/web/lib/env.ts (+ env.server.ts).
# Optional in development, REQUIRED when NODE_ENV=production: ARCJET_KEY, RESEND_API_KEY,
# DOKU_CLIENT_ID, DOKU_SECRET_KEY, APP_ENCRYPTION_KEY, EMAIL_DELIVERY (must be "resend" in production).

# --- App ---
NEXT_PUBLIC_APP_URL=            # https://app.restomate.app (local: http://localhost:3000)
NEXT_PUBLIC_ROOT_DOMAIN=        # restomate.app, bare hostname for tenant subdomains (local: localhost)

# --- Supabase (local: `supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=       # local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only, bypasses RLS

# --- PostHog (optional) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Arcjet ---
ARCJET_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=                     # Restomate <no-reply@mail.restomate.app> (default in dev; REQUIRED when EMAIL_DELIVERY=resend)
EMAIL_DELIVERY=                 # log (dev/test default; prints emails to the console) | resend. Production: must be set to resend, which also needs RESEND_API_KEY + EMAIL_FROM

# --- DOKU (Restomate's own merchant account, subscription billing; sandbox only outside production) ---
DOKU_ENV=                       # sandbox | production (default sandbox)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# --- Encryption of tenant gateway credentials ---
APP_ENCRYPTION_KEY=             # 32 bytes: 64 hex chars or base64
