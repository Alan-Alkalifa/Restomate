{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ],
      "passThroughEnv": [
        "SUPABASE_SERVICE_ROLE_KEY",
        "ARCJET_KEY",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "EMAIL_DELIVERY",
        "DOKU_ENV",
        "DOKU_CLIENT_ID",
        "DOKU_SECRET_KEY",
        "APP_ENCRYPTION_KEY"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "test:e2e": {
      "cache": false
    }
  },
  "globalPassThroughEnv": [
    "COREPACK_HOME"
  ]
}
